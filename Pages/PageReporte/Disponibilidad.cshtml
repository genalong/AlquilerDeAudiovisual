@page
@model AlquilerAudiovisual.Pages.PageReporte.DisponibilidadModel
@{
    ViewData["Title"] = "Disponibilidad de Equipamiento";
}

<div>
    <h1 class="display-4 text-center">Disponibilidad de Equipamiento</h1>
    <hr />
    <table class="table text-center">
        <thead>
            <tr>
                <th>Depósito</th>
                <th>Equipamiento</th>
                <th>Stock</th>
                <th>Comprometido</th>
                <th>Disponible</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Resultado != null && Model.Resultado.Any())
            {
                @foreach (string[] fila in Model.Resultado)
                {
                    <tr>
                        <td>@fila[0]</td>
                        <td>@fila[1]</td>
                        <td>@fila[2]</td>
                        <td>@fila[3]</td>
                        <td>@fila[4]</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No hay datos</td>
                </tr>
            }
        </tbody>
    </table>
    <a class="btn btn-warning" asp-page="/Index">Volver</a>
</div>