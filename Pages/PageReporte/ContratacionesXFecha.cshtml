@page
@model AlquilerAudiovisual.Pages.PageReporte.ContratacionesXFechaModel
@{
    ViewData["Title"] = "Contrataciones por Fecha";
}
<div>
    <h1 class="display-4 text-center">Contrataciones por Fecha</h1>

    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="fechaDesde">Fecha Desde:</label>
                    <input type="date" class="form-control" id="fechaDesde" name="fechaDesde" asp-for="fechaDesde" />
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="fechaHasta">Fecha Hasta:</label>
                    <input type="date" class="form-control" id="fechaHasta" name="fechaHasta" asp-for="fechaHasta" />
                </div>
            </div>
            <div class="col-sm-4">
                <button class="btn btn-success" style="margin-top: 23px;" type="submit" asp-page-handler="Listar">Listar</button>
            </div>
        </div>
    </form>
    
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Contrataciones != null && Model.Contrataciones.Any())
            {
                @foreach (Dominio.Contratacion unaContratacion in Model.Contrataciones)
                {
                    <tr>
                        <td>@unaContratacion.Id</td>
                        <td>@unaContratacion.FechaInicio.ToShortDateString()</td>
                        <td>@unaContratacion.FechaFin.ToShortDateString()</td>
                        <td>@unaContratacion.ImporteTotal</td>
                        <td>
                            <div>
                                <a class="btn btn-primary" asp-page="./Detalle" asp-route-id="@unaContratacion.Id">
                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                <tr>
                    <td colspan="5" class="text-right">
                        El total vendido entre estas fechas es: <strong>$@Model.TotalVendido</strong>
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">
                        No hay Contrataciones ingresadas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>