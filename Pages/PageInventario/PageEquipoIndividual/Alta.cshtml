@page
@model AlquilerAudiovisual.Pages.PageInventario.PageEquipoIndividual.AltaModel
@{
    ViewData["Title"] = "Agregar Equipo Individual";
}

<div class="text-left">
    <h1 class="display-4 text-center">Agregar Equipo Individual</h1>
    <hr />

    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label asp-for="Id">ID:</label>
                    <input class="form-control" type="number" asp-for="Id" />
                </div>

                <div class="form-group">
                    <label asp-for="NumeroSerie">Número de serie:</label>
                    <input class="form-control" type="text" asp-for="NumeroSerie" />
                </div>

                <div class="form-group">
                    <label asp-for="Estado">Estado:</label>
                    <input class="form-control" type="text" asp-for="Estado" />
                </div>

                <div class="form-group">
                    <label asp-for="IdDeposito">Depósito:</label>
                    <select class="form-control" asp-for="IdDeposito">
                        <option value="">Seleccione un depósito</option>
                        @foreach (var unDeposito in Model.ListaDepositos)
                        {
                            <option value="@unDeposito.Id">@unDeposito.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Agregar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
