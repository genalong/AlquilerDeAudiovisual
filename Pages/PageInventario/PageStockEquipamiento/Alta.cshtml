@page
@model AlquilerAudiovisual.Pages.PageInventario.PageStockEquipamiento.AltaModel
@{
    ViewData["Title"] = "Agregar Stock";
}

<div class="text-left">
    <h1 class="display-4 text-center">Agregar Stock de Equipamiento</h1>
    <hr />

    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="number" asp-for="Id" />
                </div>

                <div class="form-group">
                    <label for="equipamiento">Equipamiento:</label>
                    <select class="form-control" asp-for="IdEquipamiento">
                        <option value="">Seleccione un equipamiento</option>
                        @foreach (var unEquipamiento in Model.ListaEquipamientos)
                        {
                            <option value="@unEquipamiento.Id">@unEquipamiento.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="deposito">Depósito:</label>
                    <select class="form-control" asp-for="IdDeposito">
                        <option value="">Seleccione un depósito</option>
                        @foreach (var unDeposito in Model.ListaDepositos)
                        {
                            <option value="@unDeposito.Id">@unDeposito.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="cantidadTotal">Cantidad total:</label>
                    <input class="form-control" type="number" asp-for="CantidadTotal" />
                </div>

                <div class="form-group">
                    <label for="cantidadDisponible">Cantidad disponible:</label>
                    <input class="form-control" type="number" asp-for="CantidadDisponible" />
                </div>
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Agregar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
