@page
@model AlquilerAudiovisual.Pages.PageEvento.AltaModel

@{
    ViewData["Title"] = "Agregar Evento";
}

<div class="text-left">
    <h1 class="display-4 text-center">Agregar un Evento</h1>
    <hr />

    <form method="post">
        <div class="row">
            <div class="col-sm-4">

                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" />
                </div>

                <div class="form-group">
                    <label for="tipo">Tipo de Evento:</label>
                    <input class="form-control" type="text" name="tipo" id="tipo" />
                </div>

                <div class="form-group">
                    <label for="ubicacion">Ubicación:</label>
                    <input class="form-control" type="text" name="ubicacion" id="ubicacion" />
                </div>

                <div class="form-group">
                    <label for="fecha">Fecha:</label>
                    <input class="form-control" type="date" name="fecha" id="fecha" />
                </div>

                <div class="form-group">
                    <label for="cantidadAsistentes">Cantidad de asistentes:</label>
                    <input class="form-control" type="number" name="cantidadAsistentes" id="cantidadAsistentes" />
                </div>

            </div>
        </div>

        <hr />

        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Agregar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
