@page
@model AlquilerAudiovisual.Pages.PageEvento.EliminarModel

@{
    ViewData["Title"] = "Eliminar Evento";
}

<div class="text-left">

    <h1 class="display-4 text-center">Eliminar un Evento</h1>
    <hr />

    <form method="post" asp-page-handler="Eliminar">

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="row">
            <div class="col-sm-4">

                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text"
                           id="id" value="@Model.Id" disabled />
                </div>

                <div class="form-group">
                    <label for="tipo">Tipo de Evento:</label>
                    <input class="form-control" type="text"
                           id="tipo" value="@Model.Tipo" disabled />
                </div>

            </div>
        </div>

        <hr />

        <p>¿Está seguro de que desea eliminar este evento?</p>

        <div class="row">
            <div class="mt-2">
                <button class="btn btn-danger" type="submit">Eliminar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>

    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }

</div>
