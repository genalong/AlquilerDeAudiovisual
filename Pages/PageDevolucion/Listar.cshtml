@page
@model AlquilerAudiovisual.Pages.PageDevolucion.ListarModel
@{
    ViewData["Title"] = "Listado de Devoluciones";
}

<div>
    <h1 class="display-4 text-center">Listado de Devoluciones</h1>

    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Registrar Devolución</a>
        </div>
    </div>

    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Contratación</th>
                <th>Fecha</th>
                <th>Cargo Adicional</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaDevoluciones != null && Model.ListaDevoluciones.Any())
            {
                @foreach (Dominio.Devolucion unaDevolucion in Model.ListaDevoluciones)
                {
                    <tr>
                        <td>@unaDevolucion.Id</td>
                        <td>@unaDevolucion.ContratacionId</td>
                        <td>@unaDevolucion.FechaDevolucion.ToString("dd/MM/yyyy")</td>
                        <td>@unaDevolucion.CargoAdicionalTotal</td>
                        <td>@unaDevolucion.Observaciones</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No hay Devoluciones registradas</td>
                </tr>
            }
        </tbody>
    </table>
</div>