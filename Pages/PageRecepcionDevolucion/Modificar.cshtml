@page "{id:int}"
@model AlquilerAudiovisual.Pages.PageRecepcionDevolucion.ModificarModel

@{
    ViewData["Title"] = "Modificar recepción";
}

<div class="text-left">
    <h1 class="display-4 text-center">
        Modificar estado de recepción
    </h1>

    <hr />

    <form method="post">

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="row">
            <div class="col-sm-4">

                <div class="form-group">
                    <label for="estadoRecepcion">
                        Estado al recibirlo:
                    </label>

                    <input class="form-control" type="text"
                           name="estadoRecepcion"
                           id="estadoRecepcion"
                           value="@Model.EstadoRecepcion"
                           required />
                </div>

                <div class="form-group">
                    <label for="observaciones">Observaciones:</label>

                    <textarea class="form-control"
                              name="observaciones"
                              id="observaciones">@Model.Observaciones</textarea>
                </div>

            </div>
        </div>

        <hr />

        <button class="btn btn-success" type="submit"
                asp-page-handler="Modificar">
            Guardar cambios
        </button>

        <a class="btn btn-warning" asp-page="./Listar">
            Volver
        </a>

    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger">
            @Model.Mensaje
        </div>
    }
</div>