@page "{id:int}"
@model AlquilerAudiovisual.Pages.PageRecepcionDevolucion.EliminarModel

@{
    ViewData["Title"] = "Eliminar detalle de recepción";
}

<div class="text-left">
    <h1 class="display-4 text-center">
        Eliminar detalle de recepción
    </h1>

    <hr />

    @if (Model.UnDetalle != null)
    {
        <p>¿Seguro que desea eliminar este registro?</p>

        <dl class="row">

            <dt class="col-sm-3">ID:</dt>
            <dd class="col-sm-9">@Model.UnDetalle.Id</dd>

            <dt class="col-sm-3">Estado:</dt>
            <dd class="col-sm-9">
                @Model.UnDetalle.EstadoRecepcion
            </dd>

            <dt class="col-sm-3">Observaciones:</dt>
            <dd class="col-sm-9">
                @Model.UnDetalle.Observaciones
            </dd>

        </dl>

        <form method="post">

            <button class="btn btn-danger" type="submit"
                    asp-page-handler="Eliminar"
                    asp-route-id="@Model.UnDetalle.Id">
                Confirmar eliminación
            </button>

            <a class="btn btn-warning" asp-page="./Listar">
                Cancelar
            </a>

        </form>
    }

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />

        <div class="alert alert-danger">
            @Model.Mensaje
        </div>
    }
</div>