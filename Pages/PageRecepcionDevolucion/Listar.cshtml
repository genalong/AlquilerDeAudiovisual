@page
@model AlquilerAudiovisual.Pages.PageRecepcionDevolucion.ListarModel
@using AlquilerAudiovisual.Dominio

@{
    ViewData["Title"] = "Detalles de recepción";
}

<div class="text-left">
    <h1 class="display-4 text-center">
        Detalles de recepción de devoluciones
    </h1>

    <hr />

    <p>
        <a class="btn btn-success" asp-page="./Alta">
            Registrar recepción
        </a>
    </p>

    @if (Model.ListaDetalles.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no hay detalles de recepción registrados.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Devolución</th>
                    <th>Equipamiento</th>
                    <th>Estado al recibirlo</th>
                    <th>Observaciones</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (DetalleDevolucion unDetalle in Model.ListaDetalles)
                {
                    <tr>
                        <td>@unDetalle.Id</td>

                        <td>
                            @if (unDetalle.Devolucion != null)
                            {
                                @unDetalle.Devolucion.Id
                            }
                        </td>

                        <td>
                            @if (unDetalle.DetalleContratacion != null &&
                                unDetalle.DetalleContratacion.Equipamiento != null)
                            {
                                @unDetalle.DetalleContratacion.Equipamiento.Nombre
                            }
                        </td>

                        <td>@unDetalle.EstadoRecepcion</td>

                        <td>@unDetalle.Observaciones</td>

                        <td>
                            <a class="btn btn-primary btn-sm"
                               asp-page="./Modificar"
                               asp-route-id="@unDetalle.Id">
                                Modificar
                            </a>

                            <a class="btn btn-danger btn-sm"
                               asp-page="./Eliminar"
                               asp-route-id="@unDetalle.Id">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }

    <a class="btn btn-warning" asp-page="/PageDevolucion/Listar">
        Volver a devoluciones
    </a>
</div>