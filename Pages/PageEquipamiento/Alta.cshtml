@page
@model AlquilerAudiovisual.Pages.PageEquipamiento.AltaModel
@{
    ViewData["Title"] = "Alta de Equipamiento";
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar un Equipamiento</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" asp-for="id" readonly />
                </div>
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input class="form-control" type="text" name="nombre" id="nombre" />
                </div>
                <div class="form-group">
                    <label for="marca">Marca:</label>
                    <input class="form-control" type="text" name="marca" id="marca" />
                </div>
                <div class="form-group">
                    <label for="modelo">Modelo:</label>
                    <input class="form-control" type="text" name="modelo" id="modelo" />
                </div>
                <div class="form-group">
                    <label for="caracteristicas">Características:</label>
                    <input class="form-control" type="text" name="caracteristicas" id="caracteristicas" />
                </div>
                <div class="form-group">
                    <label for="categoria">Categoría:</label>
                    <select class="form-control" id="categoria" name="categoria">
                        <option value="Seleccione una opcion">Seleccione una opcion</option>
                        <option value="Audio">Audio</option>
                        <option value="Video">Video</option>
                        <option value="Iluminación">Iluminación</option>
                        <option value="Escenario">Escenario</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="deposito">Depósito:</label>
                    <select class="form-control" id="deposito" name="deposito">
                        <option value="0">Seleccione una opcion</option>
                        @if (Model.ListaDepositos != null)
                        {
                            @foreach (Dominio.Deposito unDeposito in Model.ListaDepositos)
                            {
                                <option value="@unDeposito.Id">@unDeposito.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="precio">Precio Base de Alquiler:</label>
                    <input class="form-control" type="number" name="precio" id="precio" />
                </div>
                <div class="form-group">
                    <label for="codigo">Código:</label>
                    <input class="form-control" type="text" name="codigo" id="codigo" />
                </div>
                <div class="form-group">
                    <label for="estado">Estado:</label>
                    <select class="form-control" id="estado" name="estado">
                        <option value="Seleccione una opcion">Seleccione una opcion</option>
                        <option value="Disponible">Disponible</option>
                        <option value="Reservado">Reservado</option>
                        <option value="En preparación">En preparación</option>
                        <option value="Alquilado">Alquilado</option>
                        <option value="En mantenimiento">En mantenimiento</option>
                        <option value="Fuera de servicio">Fuera de servicio</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="stock">Stock:</label>
                    <input class="form-control" type="number" name="stock" id="stock" />
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Agregar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>