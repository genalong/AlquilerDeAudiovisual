@page
@model AlquilerAudiovisual.Pages.PageEquipamiento.ListarModel
@{
    ViewData["Title"] = "Listado de Equipamientos";
}

<div>
    <h1 class="display-4 text-center">Listado de Equipamientos</h1>
    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Agregar</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Categoria</th>
                <th>Deposito</th>
                <th>Precio</th>
                <th>Estado</th>
                <th>Stock</th>
                <th>Disponible Hoy</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaEquipamientos != null && Model.ListaEquipamientos.Any())
            {
                @foreach (Dominio.Equipamiento unEquipamiento in Model.ListaEquipamientos)
                {
                    <tr>
                        <td>@unEquipamiento.Id</td>
                        <td>@unEquipamiento.Nombre</td>
                        <td>@unEquipamiento.Marca</td>
                        <td>@unEquipamiento.Modelo</td>
                        <td>@unEquipamiento.Categoria</td>
                        <td>@Model.NombreDeposito(unEquipamiento.DepositoId)</td>
                        <td>@unEquipamiento.PrecioBaseAlquiler</td>
                        <td>@unEquipamiento.Estado</td>
                        <td>@unEquipamiento.Stock</td>
                        <td>@Model.CalcularDisponible(unEquipamiento.Id)</td>
                        <td>
                            <a class="btn btn-primary" asp-page="./Modificar" asp-route-id="@unEquipamiento.Id">Editar</a>
                            <a class="btn btn-danger" asp-page="./Eliminar" asp-route-id="@unEquipamiento.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="11" class="text-center">No hay Equipamientos ingresados</td></tr>
            }
        </tbody>
    </table>
</div>