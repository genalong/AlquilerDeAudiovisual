@page
@model AlquilerAudiovisual.Pages.PageEquipamiento.ModificarModel

@{
    ViewData["Title"] = "Modificar Equipamiento";
}

<div class="text-left">
    <h1 class="display-4 text-center">Modificar un Equipamiento</h1>
    <hr />

    <form method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="row">
            <div class="col-sm-4">

                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input class="form-control" type="text"
                           name="nombre" id="nombre" value="@Model.Nombre" />
                </div>

                <div class="form-group">
                    <label for="tipo">Tipo:</label>
                    <input class="form-control" type="text"
                           name="tipo" id="tipo" value="@Model.Tipo" />
                </div>

                <div class="form-group">
                    <label for="precioAlquiler">Precio de alquiler:</label>
                    <input class="form-control" type="number" step="0.01"
                           name="precioAlquiler" id="precioAlquiler"
                           value="@Model.PrecioAlquiler" />
                </div>

            </div>
        </div>

        <hr />

        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit"
                        asp-page-handler="Modificar">
                    Modificar
                </button>

                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
