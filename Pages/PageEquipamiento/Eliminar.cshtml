@page
@model AlquilerAudiovisual.Pages.PageEquipamiento.EliminarModel
@{
    ViewData["Title"] = "Desactivar Equipamiento";
}

<div class="text-left">
    <h1 class="display-4 text-center">Desactivar Equipamiento</h1>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.Id)</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.Nombre)</dd>

        <dt class="col-sm-2">Marca</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.Marca)</dd>

        <dt class="col-sm-2">Modelo</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.Modelo)</dd>

        <dt class="col-sm-2">Características</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.Caracteristicas)</dd>

        <dt class="col-sm-2">Depósito</dt>
        <dd class="col-sm-10">
            @if (Model.deposito != null)
            {
                @Model.deposito.Nombre
            }
            else
            {
                @("(sin depósito)")
            }
        </dd>

        <dt class="col-sm-2">Precio Base</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.PrecioBaseAlquiler)</dd>

        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.Codigo)</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.Estado)</dd>

        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.equipamiento.Stock)</dd>
    </dl>

    <hr />

    <form method="post">
        <input type="hidden" name="id" value="@Model.equipamiento.Id" />

        <div class="row">
            <div class="mt-2">
                <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">Desactivar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
</div>