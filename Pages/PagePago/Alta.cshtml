@page
@model AlquilerAudiovisual.Pages.PagePago.AltaModel
@{
    ViewData["Title"] = "Registrar Pago";
}
<div class="text-left">
    <h1 class="display-4 text-center">Registrar Pago</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID Pago:</label>
                    <input class="form-control" type="text" name="id" id="id" asp-for="id" readonly />
                </div>
                <div class="form-group">
                    <label for="contratacion">Contratacion:</label>
                    <select class="form-control" id="contratacion" name="contratacion">
                        <option value="0">Seleccione una opcion</option>
                        @if (Model.ListaContrataciones != null)
                        {
                            @foreach (Dominio.Contratacion unaContratacion in Model.ListaContrataciones)
                            {
                                if (unaContratacion.Estado != "Cancelada")
                                {
                                    <option value="@unaContratacion.Id">ID @unaContratacion.Id - Total: @unaContratacion.ImporteTotal</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="monto">Monto:</label>
                    <input class="form-control" type="number" name="monto" id="monto" />
                </div>
                <div class="form-group">
                    <label for="metodo">Metodo de Pago:</label>
                    <select class="form-control" id="metodo" name="metodo">
                        <option value="Seleccione una opcion">Seleccione una opcion</option>
                        <option value="Efectivo">Efectivo</option>
                        <option value="Transferencia">Transferencia</option>
                        <option value="Tarjeta">Tarjeta</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="observacion">Observacion:</label>
                    <input class="form-control" type="text" name="observacion" id="observacion" />
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Registrar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>