@page
@model AlquilerAudiovisual.Pages.PagePago.ListarModel
@{
    ViewData["Title"] = "Listado de Pagos";
}

<div>
    <h1 class="display-4 text-center">Listado de Pagos</h1>

    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Registrar Pago</a>
        </div>
    </div>

    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Contratación</th>
                <th>Fecha</th>
                <th>Monto</th>
                <th>Método</th>
                <th>Observación</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaPagos != null && Model.ListaPagos.Any())
            {
                @foreach (Dominio.Pago unPago in Model.ListaPagos)
                {
                    <tr>
                        <td>@unPago.Id</td>
                        <td>@unPago.ContratacionId</td>
                        <td>@unPago.FechaPago.ToString("dd/MM/yyyy")</td>
                        <td>@unPago.Monto</td>
                        <td>@unPago.MetodoPago</td>
                        <td>@unPago.Observacion</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No hay Pagos registrados</td>
                </tr>
            }
        </tbody>
    </table>
</div>