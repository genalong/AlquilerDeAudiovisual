@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="inicio-container">

    <div class="inicio-banner">
        <div class="inicio-contenido">
            <span class="inicio-etiqueta">SISTEMA DE GESTIÓN</span>

            <h1 class="inicio-bienvenida">
                Bienvenido a Alquiler Audiovisual
            </h1>

            <p>
                Sistema para la gestión de clientes, eventos y equipamiento
                audiovisual.
            </p>
        </div>
    </div>

    <div class="modulos-container">

        <div class="modulo-card">
            <div class="modulo-icono clientes-icono">
                <i class="fas fa-users"></i>
            </div>

            <h3>Clientes</h3>
            <p>Gestión de clientes de la empresa.</p>

            <a class="btn btn-success" asp-page="/PageCliente/Listar">
                Gestionar clientes
            </a>
        </div>

        <div class="modulo-card">
            <div class="modulo-icono equipos-icono">
                <i class="fas fa-camera"></i>
            </div>

            <h3>Equipamiento</h3>
            <p>Administración de los equipos audiovisuales.</p>

            <a class="btn btn-success" asp-page="/PageEquipamiento/Listar">
                Gestionar equipamiento
            </a>
        </div>

        <div class="modulo-card">
            <div class="modulo-icono eventos-icono">
                <i class="fas fa-calendar-alt"></i>
            </div>

            <h3>Eventos</h3>
            <p>Gestión de eventos asociados a los clientes.</p>

            <a class="btn btn-success" asp-page="/PageEvento/Listar">
                Gestionar eventos
            </a>
        </div>

        <div class="modulo-card">
            <div class="modulo-icono depositos-icono">
                <i class="fas fa-warehouse"></i>
            </div>

            <h3>Depósitos</h3>
            <p>Administración de depósitos y ubicaciones.</p>

            <a class="btn btn-success" asp-page="/PageDeposito/Listar">
                Gestionar depósitos
            </a>
        </div>

    </div>

    <div class="inicio-footer">
        <p>Sistema de Gestión de Alquiler Audiovisual</p>
    </div>

</div>
