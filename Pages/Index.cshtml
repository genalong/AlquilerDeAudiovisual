@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="inicio-container">

    <div class="inicio-banner">
        <div class="inicio-contenido">
            <span class="inicio-etiqueta">SISTEMA DE GESTIÓN</span>

            <h1 class="inicio-bienvenida">
                Bienvenido a Alquiler Audiovisual
            </h1>

            <p>
                Sistema para la gestión de clientes, eventos, solicitudes,
                contrataciones, equipamiento y devoluciones audiovisuales.
            </p>
        </div>
    </div>

    <div class="modulos-container">

        <!-- CLIENTES -->
        <div class="modulo-card">
            <div class="modulo-icono clientes-icono">
                <i class="fas fa-users"></i>
            </div>

            <h3>Clientes</h3>
            <p>Gestión de clientes de la empresa.</p>

            <a class="btn btn-success" asp-page="/PageCliente/Listar">
                Gestionar clientes
            </a>
        </div>

        <!-- EQUIPAMIENTO -->
        <div class="modulo-card">
            <div class="modulo-icono equipos-icono">
                <i class="fas fa-camera"></i>
            </div>

            <h3>Equipamiento</h3>
            <p>Administración de los equipos audiovisuales.</p>

            <a class="btn btn-success" asp-page="/PageEquipamiento/Listar">
                Gestionar equipamiento
            </a>
        </div>

        <!-- EVENTOS -->
        <div class="modulo-card">
            <div class="modulo-icono eventos-icono">
                <i class="fas fa-calendar-alt"></i>
            </div>

            <h3>Eventos</h3>
            <p>Gestión de eventos asociados a los clientes.</p>

            <a class="btn btn-success" asp-page="/PageEvento/Listar">
                Gestionar eventos
            </a>
        </div>

        <!-- DEPÓSITOS -->
        <div class="modulo-card">
            <div class="modulo-icono depositos-icono">
                <i class="fas fa-warehouse"></i>
            </div>

            <h3>Depósitos</h3>
            <p>Administración de depósitos y ubicaciones.</p>

            <a class="btn btn-success" asp-page="/PageDeposito/Listar">
                Gestionar depósitos
            </a>
        </div>

        <!-- INVENTARIO -->
        <div class="modulo-card">
            <div class="modulo-icono equipos-icono">
                <i class="fas fa-boxes"></i>
            </div>

            <h3>Inventario</h3>
            <p>Consulta y administración del inventario disponible.</p>

            <a class="btn btn-success" asp-page="/PageInventario/Listar">
                Gestionar inventario
            </a>
        </div>

        <!-- SOLICITUDES -->
        <div class="modulo-card">
            <div class="modulo-icono eventos-icono">
                <i class="fas fa-file-alt"></i>
            </div>

            <h3>Solicitudes</h3>
            <p>Administración de solicitudes de alquiler.</p>

            <a class="btn btn-success" asp-page="/PageSolicitud/Listar">
                Gestionar solicitudes
            </a>
        </div>

        <!-- CONTRATACIONES -->
        <div class="modulo-card">
            <div class="modulo-icono clientes-icono">
                <i class="fas fa-file-signature"></i>
            </div>

            <h3>Contrataciones</h3>
            <p>Gestión de contrataciones y alquileres confirmados.</p>

            <a class="btn btn-success" asp-page="/PageContratacion/Listar">
                Gestionar contrataciones
            </a>
        </div>

        <!-- DEVOLUCIONES -->
        <div class="modulo-card">
            <div class="modulo-icono depositos-icono">
                <i class="fas fa-undo-alt"></i>
            </div>

            <h3>Devoluciones</h3>
            <p>Registro y administración de las devoluciones de equipamiento.</p>

            <a class="btn btn-success" asp-page="/PageDevolucion/Listar">
                Gestionar devoluciones
            </a>
        </div>

        <!-- RECEPCIÓN DE DEVOLUCIONES -->
        <div class="modulo-card">
            <div class="modulo-icono equipos-icono">
                <i class="fas fa-clipboard-check"></i>
            </div>

            <h3>Recepción de devoluciones</h3>
            <p>Registro del equipamiento recibido y su estado al momento de la devolución.</p>

            <a class="btn btn-success" asp-page="/PageRecepcionDevolucion/Listar">
                Gestionar recepción
            </a>
        </div>

    </div>

    <div class="inicio-footer">
        <p>Sistema de Gestión de Alquiler Audiovisual</p>
    </div>

</div>