@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Sistema de Alquiler de Equipamiento Audiovisual</h1>
    <p class="lead">Gestión de clientes, equipamiento y contrataciones.</p>
</div>

<hr />

<div class="row">

    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Clientes</h5>
            </div>
            <div class="card-body">
                <p>Registrar, consultar, modificar y desactivar clientes.</p>
                <a class="btn btn-outline-primary btn-sm" asp-page="/PageCliente/Listar">Ver Clientes</a>
                <a class="btn btn-outline-success btn-sm" asp-page="/PageCliente/Alta">Nuevo Cliente</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Depósitos</h5>
            </div>
            <div class="card-body">
                <p>Administrar los depósitos donde se guarda el equipamiento.</p>
                <a class="btn btn-outline-primary btn-sm" asp-page="/PageDeposito/Listar">Ver Depósitos</a>
                <a class="btn btn-outline-success btn-sm" asp-page="/PageDeposito/Alta">Nuevo Depósito</a>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Equipamiento</h5>
            </div>
            <div class="card-body">
                <p>Administrar el equipamiento audiovisual y su estado.</p>
                <a class="btn btn-outline-info btn-sm" asp-page="/PageEquipamiento/Listar">Ver Equipamiento</a>
                <a class="btn btn-outline-success btn-sm" asp-page="/PageEquipamiento/Alta">Nuevo Equipo</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Contrataciones</h5>
            </div>
            <div class="card-body">
                <p>Consultar y gestionar las contrataciones de equipos.</p>
                <a class="btn btn-outline-info btn-sm" asp-page="/PageContratacion/Listar">Ver Contrataciones</a>
                <a class="btn btn-outline-success btn-sm" asp-page="/PageContratacion/Alta">Nueva Contratación</a>
            </div>
        </div>
    </div>

</div>

<div class="row mt-3">
    <div class="col-md-12 mb-3">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Reportes</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <a class="btn btn-outline-dark btn-sm w-100" asp-page="/PageReporte/ContratacionesXCliente">Contrataciones por Cliente</a>
                    </div>
                    <div class="col-md-4 mb-2">
                        <a class="btn btn-outline-dark btn-sm w-100" asp-page="/PageReporte/ContratacionesXFecha">Contrataciones por Fecha</a>
                    </div>
                    <div class="col-md-4 mb-2">
                        <a class="btn btn-outline-dark btn-sm w-100" asp-page="/PageReporte/ContratacionesXEquipo">Contrataciones por Equipamiento</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>