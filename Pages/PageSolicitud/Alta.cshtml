@page
@model AlquilerAudiovisual.Pages.PageSolicitud.AltaModel
@{
    ViewData["Title"] = "Nueva Solicitud";
}
<div class="text-left">
    <h1 class="display-4 text-center">Nueva Solicitud de Alquiler</h1>
    <hr />

    @if (Model.SolicitudEnCurso == null)
    {
        <!-- PASO 1: Datos de la solicitud -->
        <h4>Paso 1: Datos de la Solicitud</h4>
        <form method="post">
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="id">ID Solicitud:</label>
                        <input class="form-control" type="text" name="id" id="id" />
                    </div>
                    <div class="form-group">
                        <label for="cliente">Cliente:</label>
                        <select class="form-control" name="cliente" id="cliente">
                            <option value="">Seleccione...</option>
                            @if (Model.ListaClientes != null)
                            {
                                @foreach (Dominio.Cliente unCliente in Model.ListaClientes)
                                {
                                    if (unCliente.Activo)
                                    {
                                        <option value="@unCliente.Id">@unCliente.Nombre</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="nombreevento">Nombre del Evento:</label>
                        <input class="form-control" type="text" name="nombreevento" id="nombreevento" />
                    </div>
                    <div class="form-group">
                        <label for="fecha">Fecha del Evento:</label>
                        <input class="form-control" type="date" name="fecha" id="fecha" />
                    </div>
                    <div class="form-group">
                        <label for="ubicacion">Ubicación:</label>
                        <input class="form-control" type="text" name="ubicacion" id="ubicacion" />
                    </div>
                    <div class="form-group">
                        <label for="horainicio">Hora Inicio:</label>
                        <input class="form-control" type="time" name="horainicio" id="horainicio" />
                    </div>
                    <div class="form-group">
                        <label for="horafin">Hora Fin:</label>
                        <input class="form-control" type="time" name="horafin" id="horafin" />
                    </div>
                    <div class="form-group">
                        <label for="asistentes">Cantidad de Asistentes:</label>
                        <input class="form-control" type="text" name="asistentes" id="asistentes" />
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="mt-2">
                    <button class="btn btn-success" type="submit" asp-page-handler="AgregarSolicitud">Agregar Solicitud</button>
                    <a class="btn btn-warning" asp-page="./Listar">Volver</a>
                </div>
            </div>
        </form>
    }
    else
    {
        <!-- PASO 2: Agregar equipamiento -->
        <h4>Paso 2: Agregar Equipamiento</h4>
        <p>
            <strong>Solicitud en curso:</strong> ID @Model.SolicitudEnCurso.Id -
            @Model.SolicitudEnCurso.NombreEvento
        </p>

        <form method="post">
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="equipamiento">Equipamiento:</label>
                        <select class="form-control" name="equipamiento" id="equipamiento">
                            <option value="">Seleccione...</option>
                            @if (Model.ListaEquipamientos != null)
                            {
                                @foreach (Dominio.Equipamiento unEquipamiento in Model.ListaEquipamientos)
                                {
                                    if (unEquipamiento.Activo)
                                    {
                                        <option value="@unEquipamiento.Id">@unEquipamiento.Nombre (@unEquipamiento.Marca)</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="cantidad">Cantidad:</label>
                        <input class="form-control" type="text" name="cantidad" id="cantidad" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="mt-2">
                    <button class="btn btn-primary" type="submit" asp-page-handler="AgregarLinea">Agregar Línea</button>
                </div>
            </div>
        </form>

        <hr />

        <h5>Equipamientos Agregados</h5>
        <table class="table text-center">
            <thead>
                <tr>
                    <th>Línea</th>
                    <th>Equipamiento</th>
                    <th>Cantidad</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LineasEnCurso != null && Model.LineasEnCurso.Any())
                {
                    @foreach (Dominio.LineaSolicitud unaLinea in Model.LineasEnCurso)
                    {
                        <tr>
                            <td>@unaLinea.Id</td>
                            <td>@Model.NombreEquipamiento(unaLinea.EquipamientoId)</td>
                            <td>@unaLinea.Cantidad</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="lineaid" value="@unaLinea.Id" />
                                    <button type="submit" class="btn btn-danger" asp-page-handler="QuitarLinea">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">No hay equipamientos agregados todavía</td>
                    </tr>
                }
            </tbody>
        </table>

        <hr />

        <form method="post">
            <button class="btn btn-success" type="submit" asp-page-handler="Finalizar">Finalizar y Guardar Solicitud</button>
            <a class="btn btn-warning" asp-page="./Listar">Cancelar</a>
        </form>
    }

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>