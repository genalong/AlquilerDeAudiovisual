@page
@model AlquilerAudiovisual.Pages.PageSolicitud.ListarModel
@{
    ViewData["Title"] = "Listado de Solicitudes";
}

<div>
    <h1 class="display-4 text-center">Listado de Solicitudes</h1>

    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Nueva Solicitud</a>
        </div>
    </div>

    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Evento</th>
                <th>Fecha</th>
                <th>Horario</th>
                <th>Ubicación</th>
                <th>Asistentes</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaSolicitudes != null && Model.ListaSolicitudes.Any())
            {
                @foreach (Dominio.SolicitudAlquiler unaSolicitud in Model.ListaSolicitudes)
                {
                    <tr>
                        <td>@unaSolicitud.Id</td>
                        <td>@Model.NombreCliente(unaSolicitud.ClienteId)</td>
                        <td>@unaSolicitud.NombreEvento</td>
                        <td>@unaSolicitud.FechaEvento.ToString("dd/MM/yyyy")</td>
                        <td>@unaSolicitud.HoraInicio - @unaSolicitud.HoraFin</td>
                        <td>@unaSolicitud.Ubicacion</td>
                        <td>@unaSolicitud.CantidadAsistentes</td>
                        <td>@unaSolicitud.Estado</td>
                        <td>
                            @if (unaSolicitud.Estado == "Pendiente")
                            {
                                <a class="btn btn-success" asp-page="./Aceptar" asp-route-id="@unaSolicitud.Id">Aceptar</a>
                                <a class="btn btn-warning" asp-page="./Cancelar" asp-route-id="@unaSolicitud.Id">Cancelar</a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">
                        No hay Solicitudes ingresadas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>