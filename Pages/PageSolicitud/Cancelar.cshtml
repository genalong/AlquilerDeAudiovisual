@page
@model AlquilerAudiovisual.Pages.PageSolicitud.CancelarModel
@{
    ViewData["Title"] = "Cancelar Solicitud";
}

<div class="text-left">
    <h1 class="display-4 text-center">Cancelar Solicitud</h1>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.solicitud.Id)</dd>

        <dt class="col-sm-2">Evento</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.solicitud.NombreEvento)</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.solicitud.FechaEvento.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.solicitud.Estado)</dd>
    </dl>

    <hr />

    <form method="post">
        <input type="hidden" name="id" value="@Model.solicitud.Id" />

        <div class="row">
            <div class="mt-2">
                <button type="submit" asp-page-handler="Cancelar" class="btn btn-danger">Cancelar Solicitud</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
</div>