@page
@model AlquilerAudiovisual.Pages.PageSolicitud.AceptarModel
@{
    ViewData["Title"] = "Aceptar Solicitud";
}

<div class="text-left">
    <h1 class="display-4 text-center">Aceptar Solicitud</h1>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.solicitud.Id</dd>

        <dt class="col-sm-2">Tipo Evento</dt>
        <dd class="col-sm-10">@Model.solicitud.TipoEvento</dd>

        <dt class="col-sm-2">Nombre Evento</dt>
        <dd class="col-sm-10">@Model.solicitud.NombreEvento</dd>

        <dt class="col-sm-2">Fecha Inicio</dt>
        <dd class="col-sm-10">@Model.solicitud.FechaInicio.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Fecha Fin</dt>
        <dd class="col-sm-10">@Model.solicitud.FechaFin.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Ubicacion</dt>
        <dd class="col-sm-10">@Model.solicitud.Ubicacion</dd>

        <dt class="col-sm-2">Asistentes</dt>
        <dd class="col-sm-10">@Model.solicitud.CantidadAsistentes</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.solicitud.Estado</dd>
    </dl>

    <hr />

    <h5>Equipamiento Solicitado</h5>
    <table class="table text-center">
        <thead>
            <tr>
                <th>Equipamiento</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.lineas != null && Model.lineas.Any())
            {
                @foreach (Dominio.LineaSolicitud unaLinea in Model.lineas)
                {
                    <tr>
                        <td>@Model.NombreEquipamiento(unaLinea.EquipamientoId)</td>
                        <td>@unaLinea.Cantidad</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center">No hay equipamiento en la solicitud</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <form method="post">
        <input type="hidden" name="id" value="@Model.solicitud.Id" />
        <div class="row">
            <div class="mt-2">
                <button type="submit" asp-page-handler="Aceptar" class="btn btn-success">Aceptar y Generar Contratacion</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>