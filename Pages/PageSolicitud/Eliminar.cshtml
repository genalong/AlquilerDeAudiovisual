@page "{id:int}"
@model AlquilerAudiovisual.Pages.PageSolicitud.EliminarModel
@{
    ViewData["Title"] = "Eliminar Solicitud";
}

<div class="text-left">
    <h1 class="display-4 text-center">Eliminar Solicitud</h1>
    <hr />

    @if (Model.UnaSolicitud != null)
    {
        <p>¿Está seguro de que desea eliminar esta solicitud?</p>

        <p><strong>ID:</strong> @Model.UnaSolicitud.Id</p>
        <p><strong>Estado:</strong> @Model.UnaSolicitud.Estado</p>

        <form method="post">
            <input type="hidden" name="id" value="@Model.UnaSolicitud.Id" />

            <button class="btn btn-danger" type="submit" asp-page-handler="Eliminar">Eliminar</button>
            <a class="btn btn-warning" asp-page="./Listar">Volver</a>
        </form>
    }
    else
    {
        <div class="alert alert-danger">
            No se encontró la solicitud.
        </div>
        <a class="btn btn-warning" asp-page="./Listar">Volver</a>
    }

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
