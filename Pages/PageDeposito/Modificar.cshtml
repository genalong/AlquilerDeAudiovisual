@page
@model AlquilerAudiovisual.Pages.PageDeposito.ModificarModel
@{
    ViewData["Title"] = "Modificar Depósito";
}
<div class="text-left">
    <h1 class="display-4 text-center">Modificar un Depósito</h1>
    <hr />
    <form method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input class="form-control" type="text" name="nombre" id="nombre" value="@Model.Nombre" />
                </div>
                <div class="form-group">
                    <label for="direccion">Dirección:</label>
                    <input class="form-control" type="text" name="direccion" id="direccion" value="@Model.Direccion" />
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Modificar">Modificar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
