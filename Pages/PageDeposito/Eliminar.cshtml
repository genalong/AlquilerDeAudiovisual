@page
@model AlquilerAudiovisual.Pages.PageDeposito.EliminarModel
@{
    ViewData["Title"] = "Eliminar Depósito";
}
<div class="text-left">
    <h1 class="display-4 text-center">Eliminar un Depósito</h1>
    <hr />
    <form method="post" asp-page-handler="Eliminar">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" id="id" value="@Model.Id" disabled />
                </div>
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input class="form-control" type="text" id="nombre" value="@Model.Nombre" disabled />
                </div>
                <div class="form-group">
                    <label for="direccion">Dirección:</label>
                    <input class="form-control" type="text" id="direccion" value="@Model.Direccion" disabled />
                </div>
            </div>
        </div>
        <hr />
        <p>¿Está seguro de que desea eliminar este depósito?</p>
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-danger" type="submit">Eliminar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
