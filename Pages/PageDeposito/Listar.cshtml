@page
@model AlquilerAudiovisual.Pages.PageDeposito.ListarModel
@{
    ViewData["Title"] = "Listado de Depósitos";
}

<div>
    <h1 class="display-4 text-center">Listado de Depósitos</h1>

    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Agregar</a>
        </div>
    </div>

    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Dirección</th>
                <th>Responsable</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaDepositos != null && Model.ListaDepositos.Any())
            {
                @foreach (Dominio.Deposito unDeposito in Model.ListaDepositos)
                {
                    <tr>
                        <td>@unDeposito.Id</td>
                        <td>@unDeposito.Nombre</td>
                        <td>@unDeposito.Direccion</td>
                        <td>@unDeposito.Responsable</td>
                        <td>
                            <div>
                                <a class="btn btn-primary" asp-page="./Modificar" asp-route-id="@unDeposito.Id">
                                    <i class="fa fa-edit" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-danger" asp-page="./Eliminar" asp-route-id="@unDeposito.Id">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">
                        No hay Depósitos ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>