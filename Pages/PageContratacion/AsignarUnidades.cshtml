@page
@model AlquilerAudiovisual.Pages.PageContratacion.AsignarUnidadesModel
@{
    ViewData["Title"] = "Preparar Contratación";
}

<div class="text-left">
    <h1 class="display-4 text-center">Preparar Contratación</h1>
    <hr />

    <p>
        <strong>Contratación ID:</strong> @Model.contratacion.Id<br />
        <strong>Estado actual:</strong> @Model.contratacion.Estado
    </p>

    <h5>Equipamiento a Preparar</h5>
    <table class="table text-center">
        <thead>
            <tr>
                <th>Equipamiento</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.lineas != null && Model.lineas.Any())
            {
                @foreach (Dominio.LineaContratacion unaLinea in Model.lineas)
                {
                    <tr>
                        <td>@Model.NombreEquipamiento(unaLinea.EquipamientoId)</td>
                        <td>@unaLinea.Cantidad</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <hr />

    <form method="post">
        <input type="hidden" name="contratacionid" value="@Model.contratacion.Id" />
        <div class="row">
            <div class="mt-2">
                <button type="submit" asp-page-handler="Asignar" class="btn btn-success">Marcar como Activa</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>