@page
@model AlquilerAudiovisual.Pages.PageContratacion.AltaModel
@{
    ViewData["Title"] = "Nueva Contratacion";
}
<div class="text-left">
    <h1 class="display-4 text-center">Nueva Contratacion</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" asp-for="id" readonly />
                </div>
                <div class="form-group">
                    <label for="cliente">Cliente:</label>
                    <select class="form-control" id="cliente" name="cliente">
                        <option value="0">Seleccione una opcion</option>
                        @if (Model.ListaClientes != null)
                        {
                            @foreach (Dominio.Cliente unCliente in Model.ListaClientes)
                            {
                                if (unCliente.Activo)
                                {
                                    <option value="@unCliente.Id">@unCliente.Nombre</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="equipamiento">Equipamiento:</label>
                    <select class="form-control" id="equipamiento" name="equipamiento">
                        <option value="0">Seleccione una opcion</option>
                        @if (Model.ListaEquipamientos != null)
                        {
                            @foreach (Dominio.Equipamiento unEquipamiento in Model.ListaEquipamientos)
                            {
                                if (unEquipamiento.Activo)
                                {
                                    <option value="@unEquipamiento.Id">@unEquipamiento.Nombre</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="cantidad">Cantidad:</label>
                    <input class="form-control" type="number" name="cantidad" id="cantidad" />
                </div>
                <div class="form-group">
                    <label for="fechainicio">Fecha Inicio:</label>
                    <input class="form-control" type="date" name="fechainicio" id="fechainicio" />
                </div>
                <div class="form-group">
                    <label for="fechafin">Fecha Fin:</label>
                    <input class="form-control" type="date" name="fechafin" id="fechafin" />
                </div>
                <div class="form-group">
                    <label for="ubicacion">Ubicacion:</label>
                    <input class="form-control" type="text" name="ubicacion" id="ubicacion" />
                </div>
                <div class="form-group">
                    <label for="importetotal">Importe Total:</label>
                    <input class="form-control" type="number" name="importetotal" id="importetotal" />
                </div>
                <div class="form-group">
                    <label for="estado">Estado:</label>
                    <select class="form-control" id="estado" name="estado">
                        <option value="Seleccione una opcion">Seleccione una opcion</option>
                        <option value="Aprobado">Aprobado</option>
                        <option value="Rechazado">Rechazado</option>
                    </select>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Agregar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>