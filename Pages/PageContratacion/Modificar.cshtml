@page
@model AlquilerAudiovisual.Pages.PageContratacion.ModificarModel
@{
    ViewData["Title"] = "Modificar Contratación";
}

<div class="text-left">
    <h1 class="display-4 text-center">Modificar Contratación</h1>
    <hr />

    <form method="post">

        <div class="row">
            <div class="col-sm-4">

                <div class="form-group">
                    <label>ID:</label>
                    <input class="form-control" type="number" name="id"
                           value="@Model.Id" readonly />
                </div>

                <div class="form-group">
                    <label for="fecha">Fecha:</label>
                    <input class="form-control" type="date" name="fecha"
                           id="fecha" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <label>Total:</label>
                    <input class="form-control" type="number"
                           value="@Model.Total" readonly />
                </div>

                <div class="form-group">
                    <label for="estado">Estado:</label>
                    <input class="form-control" type="text" name="estado"
                           id="estado" value="@Model.Estado" />
                </div>

            </div>
        </div>

        <hr />

        <button class="btn btn-success" type="submit"
                asp-page-handler="Modificar">
            Guardar cambios
        </button>

        <a class="btn btn-warning" asp-page="./Listar">Volver</a>

    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger">
            @Model.Mensaje
        </div>
    }
</div>