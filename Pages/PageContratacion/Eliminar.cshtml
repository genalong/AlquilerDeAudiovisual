@page
@model AlquilerAudiovisual.Pages.PageContratacion.EliminarModel
@{
    ViewData["Title"] = "Eliminar Contratación";
}

<div class="text-left">

    <h1 class="display-4 text-center">Eliminar Contratación</h1>
    <hr />

    <form method="post">

        <div class="row">
            <div class="col-sm-4">

                <div class="form-group">
                    <label for="id">ID de la Contratación:</label>
                    <input class="form-control" type="number"
                           name="id" id="id" value="@Model.Id" readonly />
                </div>

            </div>
        </div>

        <hr />

        <p>¿Está seguro de que desea eliminar esta Contratación?</p>

        <div class="mt-2">

            <button class="btn btn-danger" type="submit"
                    asp-page-handler="Eliminar">
                Eliminar
            </button>

            <a class="btn btn-warning" asp-page="./Listar">
                Volver
            </a>

        </div>

    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }

</div>