@page
@model AlquilerAudiovisual.Pages.PageContratacion.ListarModel
@{
    ViewData["Title"] = "Listado de Contrataciones";
}

<div>
    <h1 class="display-4 text-center">Listado de Contrataciones</h1>
    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Agregar</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Equipamiento</th>
                <th>Cantidad</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaContrataciones != null && Model.ListaContrataciones.Any())
            {
                @foreach (Dominio.Contratacion unaContratacion in Model.ListaContrataciones)
                {
                    <tr>
                        <td>@unaContratacion.Id</td>
                        <td>@Model.NombreCliente(unaContratacion.ClienteId)</td>
                        <td>@Model.NombreEquipamiento(unaContratacion.EquipamientoId)</td>
                        <td>@unaContratacion.Cantidad</td>
                        <td>@unaContratacion.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@unaContratacion.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>@unaContratacion.Estado</td>
                        <td>
                            <a class="btn btn-primary" asp-page="./Modificar" asp-route-id="@unaContratacion.Id">Editar</a>
                            <a class="btn btn-danger" asp-page="./Eliminar" asp-route-id="@unaContratacion.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8" class="text-center">No hay Contrataciones ingresadas</td></tr>
            }
        </tbody>
    </table>
</div>