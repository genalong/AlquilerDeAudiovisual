@page
@model AlquilerAudiovisual.Pages.PageContratacion.ListarModel
@{
    ViewData["Title"] = "Listado de Contrataciones";
}

<div>
    <h1 class="display-4 text-center">Listado de Contrataciones</h1>

    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Horario</th>
                <th>Ubicación</th>
                <th>Importe Total</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaContrataciones != null && Model.ListaContrataciones.Any())
            {
                @foreach (Dominio.Contratacion unaContratacion in Model.ListaContrataciones)
                {
                    <tr>
                        <td>@unaContratacion.Id</td>
                        <td>@Model.NombreCliente(unaContratacion.ClienteId)</td>
                        <td>@unaContratacion.FechaEvento.ToString("dd/MM/yyyy")</td>
                        <td>@unaContratacion.HoraInicio - @unaContratacion.HoraFin</td>
                        <td>@unaContratacion.Ubicacion</td>
                        <td>@unaContratacion.ImporteTotal</td>
                        <td>@unaContratacion.Estado</td>
                        <td>
                            <a class="btn btn-primary" asp-page="./Detalle" asp-route-id="@unaContratacion.Id">Detalle</a>
                            <a class="btn btn-info" asp-page="./AsignarUnidades" asp-route-id="@unaContratacion.Id">Asignar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">
                        No hay Contrataciones ingresadas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>