@page
@model AlquilerAudiovisual.Pages.PageContratacion.DetalleModel
@{
    ViewData["Title"] = "Detalle de Contratación";
}

<div class="text-left">
    <h1 class="display-4 text-center">Detalle de Contratación</h1>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.contratacion.Id)</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.contratacion.FechaEvento.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Horario</dt>
        <dd class="col-sm-10">@Model.contratacion.HoraInicio - @Model.contratacion.HoraFin</dd>

        <dt class="col-sm-2">Ubicación</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.contratacion.Ubicacion)</dd>

        <dt class="col-sm-2">Importe Total</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.contratacion.ImporteTotal)</dd>

        <dt class="col-sm-2">Saldo Pendiente</dt>
        <dd class="col-sm-10">@Model.SaldoPendiente</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.contratacion.Estado)</dd>
    </dl>

    <hr />

    <h5>Equipamiento Contratado</h5>
    <table class="table text-center">
        <thead>
            <tr>
                <th>Equipamiento</th>
                <th>Cantidad</th>
                <th>Precio Unitario</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.lineas != null && Model.lineas.Any())
            {
                @foreach (Dominio.LineaContratacion unaLinea in Model.lineas)
                {
                    <tr>
                        <td>@Model.NombreEquipamiento(unaLinea.EquipamientoId)</td>
                        <td>@unaLinea.Cantidad</td>
                        <td>@unaLinea.PrecioUnitario</td>
                        <td>@(unaLinea.Cantidad * unaLinea.PrecioUnitario)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No hay equipamiento en la contratación</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <h5>Pagos Registrados</h5>
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Monto</th>
                <th>Método</th>
                <th>Observación</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaPagos != null && Model.ListaPagos.Any())
            {
                @foreach (Dominio.Pago unPago in Model.ListaPagos)
                {
                    <tr>
                        <td>@unPago.Id</td>
                        <td>@unPago.FechaPago.ToString("dd/MM/yyyy")</td>
                        <td>@unPago.Monto</td>
                        <td>@unPago.MetodoPago</td>
                        <td>@unPago.Observacion</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No hay pagos registrados</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <a class="btn btn-warning" asp-page="./Listar">Volver</a>
</div>