@page
@model AlquilerAudiovisual.Pages.PageCliente.EliminarModel
@{
    ViewData["Title"] = "Desactivar Cliente";
}

<div class="text-left">
    <h1 class="display-4 text-center">Desactivar Cliente</h1>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.cliente.Id)</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.cliente.Nombre)</dd>

        <dt class="col-sm-2">Tipo</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.cliente.Tipo)</dd>

        <dt class="col-sm-2">Documento</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.cliente.Documento)</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.cliente.Telefono)</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.cliente.Email)</dd>

        <dt class="col-sm-2">Dirección</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.cliente.Direccion)</dd>
    </dl>

    <hr />

    <form method="post">
        <input type="hidden" name="id" value="@Model.cliente.Id" />

        <div class="row">
            <div class="mt-2">
                <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">Desactivar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
</div>