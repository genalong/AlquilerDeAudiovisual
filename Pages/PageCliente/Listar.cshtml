@page
@model AlquilerAudiovisual.Pages.PageCliente.ListarModel
@{
    ViewData["Title"] = "Listado de Clientes";
}

<div>
    <h1 class="display-4 text-center">Listado de Clientes</h1>

    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Agregar</a>
        </div>
    </div>

    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Dirección</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaClientes != null && Model.ListaClientes.Any())
            {
                @foreach (Dominio.Cliente unCliente in Model.ListaClientes)
                {
                    <tr>
                        <td>@unCliente.Id</td>
                        <td>@unCliente.Nombre</td>
                        <td>@unCliente.Telefono</td>
                        <td>@unCliente.Email</td>
                        <td>@unCliente.Direccion</td>
                        <td>
                            <div>
                                <a class="btn btn-primary" asp-page="./Modificar" asp-route-id="@unCliente.Id">
                                    <i class="fa fa-edit" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-danger" asp-page="./Eliminar" asp-route-id="@unCliente.Id">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No hay Clientes ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
